# PostgreSQL & PostGIS Configuration
POSTGRES_DB=vdbus_logistics
POSTGRES_USER=vdbus_admin
POSTGRES_PASSWORD=vdbus_secret_password_change_in_prod
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password_change_in_prod

# MQTT Broker (Mosquitto / EMQX)
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Backend Environment
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=vdbus_logistics;Username=vdbus_admin;Password=vdbus_secret_password_change_in_prod;
ConnectionStrings__Redis=redis:6379,password=redis_secret_password_change_in_prod
Jwt__Secret=vdbus_super_secret_jwt_key_at_least_32_chars_long!
Jwt__Issuer=VDBusPlatform
Jwt__Audience=VDBusClients
